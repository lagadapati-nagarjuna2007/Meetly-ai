PORT=5000
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Gmail API OAuth Credentials for OTP Email Sending
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=your-authorized-sender-email@gmail.com

JWT_SECRET=your-jwt-secret

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Summary Generator - NVIDIA NIM (Primary)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI Summary Generator - Groq (Optional Fallback)
GROQ_API_KEY=your-groq-api-key

# AI Chat Assistant
AI_CHAT_API_KEY=your-openai-or-openrouter-key
AI_CHAT_MODEL=openai/gpt-oss-120b

# Backblaze B2 - Screen Recording
B2_APPLICATION_KEY=your-backblaze-application-key
B2_BUCKET_NAME=your-private-bucket-name
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_KEY_ID=your-backblaze-key-id
B2_REGION=your-region

# Cloudflare RealtimeKit Config (Sole Media Provider)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_REALTIME_APP_ID=your_realtime_app_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_REALTIME_HOST_PRESET=group_call_host
CLOUDFLARE_REALTIME_PARTICIPANT_PRESET=group_call_participant
