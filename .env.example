PORT=5000
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Gmail API OAuth Credentials for OTP Email Sending
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=your-authorized-sender-email@gmail.com

JWT_SECRET=your-jwt-secret

# Backend LiveKit Cloud Config
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_LIVEKIT_URL=wss://your-livekit-url.livekit.cloud

# AI Summary Generator - NVIDIA NIM (Primary)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI Summary Generator - Groq (Optional Fallback)
GROQ_API_KEY=your-groq-api-key

# AI Chat Assistant
AI_CHAT_API_KEY=your-openai-or-openrouter-key
AI_CHAT_MODEL=openai/gpt-oss-120b
